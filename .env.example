# Database
POSTGRES_USER=raguser
POSTGRES_PASSWORD=your_db_password_here
POSTGRES_DB=ragdb
DATABASE_URL=postgresql://raguser:your_db_password_here@postgres:5432/ragdb

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_minio_secret_here

# Redis & Vector DB
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333

# App
# GitHub Models requires a token with the `models: read` permission.
GITHUB_MODELS_TOKEN=your_github_models_token_here
CHATGPT_MODEL=openai/gpt-4.1
SECRET_KEY=your_secret_key_here
